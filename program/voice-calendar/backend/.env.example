FLASK_ENV=development
STT_PROVIDER=aliyun
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest

# 阿里云 NLS 一句话识别（STT_PROVIDER=aliyun 时使用）
# 控制台：https://nls-portal.console.aliyun.com/  RAM：https://ram.console.aliyun.com/
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_NLS_APP_KEY=your-nls-app-key

# OpenAI 在线方案（LLM_PROVIDER=openai 时使用）
# OPENAI_API_KEY=sk-你的key填这里
# OPENAI_MODEL=gpt-4o-mini
